# EXCLUDE rules for Raspberry Pi OS root backup
# These items will NOT be backed up.
# Everything else WILL be backed up.

/lost+found
/tmp
/mnt
/media
/dev
/run
/proc
/sys
/swap
/swapfile
/var/lib/apache2/fcgid/sock/*
/var/lib/rspamd/rspamd.sock
/var/spool/postfix/dev/log
/var/spool/postfix/private/*
/var/spool/postfix/public/*

# Notes:
# - Leading slash anchors the exclude to the root of the backed-up folder.
# - Use wildcards: *, ?, []
# - Lines starting with # are ignored.
